---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { products } from '../config/site';
import { routes, t, type Lang } from '../i18n/ui';
import { url } from '../utils/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i18n = t(lang);

const featured = products.filter((p) => p.featured);
const collage = featured.slice(0, 4);
const tokens = ['briefcase-medical', 'stethoscope', 'syringe', 'vials'];
const valueIcons = ['prescription-bottle', 'briefcase-medical', 'handshake-regular', 'stethoscope'];
---

<BaseLayout lang={lang} page="home">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="panel hero__panel grid grid--2">
        <div>
          <span class="eyebrow">{i18n.hero.eyebrow}</span>
          <h1 class="title-grad">{i18n.hero.title}</h1>
          <p class="hero__lead">{i18n.hero.lead}</p>
          <div class="btn-row">
            <a href={url(routes.offer[lang])} class="btn">{i18n.seeOffer}</a>
            <a href={url(routes.contact[lang])} class="btn btn--ghost">{i18n.askOffer}</a>
          </div>
          <dl class="facts">
            {i18n.facts.map((f) => (
              <div>
                <dt>{f.value}</dt>
                <dd>{f.label}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="collage" aria-hidden="true">
          {collage.map((p, i) => (
            <div class="collage__item">
              <Picture
                src={p.image}
                alt=""
                formats={['avif', 'webp']}
                widths={[200, 300, 400]}
                sizes="(max-width: 860px) 42vw, 260px"
                loading={i < 2 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
              />
            </div>
          ))}
          <div class="trust" title={i18n.hero.trust}>
            <Icon name="handshake-regular" size={28} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MEDICAL BAND -->
  <section class="section band-wrap">
    <div class="container">
      <div class="band center">
        <ul class="tokens" aria-hidden="true">
          {tokens.map((name) => (
            <li class="token"><Icon name={name} size={30} /></li>
          ))}
        </ul>
        <h2>{i18n.band.title}</h2>
        <p>{i18n.band.text}</p>
        <a href={url(routes.offer[lang])} class="btn btn--white">{i18n.seeOffer}</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section" id={i18n.aboutId}>
    <div class="container">
      <SectionHeading eyebrow={i18n.about.eyebrow} title={i18n.about.title}>
        <p>{i18n.about.text}</p>
      </SectionHeading>
      <div class="grid grid--4">
        {i18n.about.values.map((v, i) => (
          <div class="card value">
            <span class="value__icon"><Icon name={valueIcons[i]} size={24} /></span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  <section class="section featured">
    <div class="container">
      <SectionHeading eyebrow={i18n.featured.eyebrow} title={i18n.featured.title}>
        <p>{i18n.featured.text}</p>
      </SectionHeading>
      <div class="grid grid--3">
        {featured.map((product) => <ProductCard product={product} lang={lang} />)}
      </div>
      <div class="center featured__more">
        <a href={url(routes.offer[lang])} class="btn">{i18n.seeAll}</a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .hero { padding-top: clamp(8px, 2vw, 24px); }
  .hero__panel {
    position: relative;
    padding: clamp(32px, 6vw, 80px) clamp(20px, 5vw, 64px);
    gap: clamp(32px, 5vw, 64px);
  }
  .hero__lead { font-size: clamp(1rem, 1.6vw, 1.15rem); max-width: 34em; margin-bottom: 2rem; }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 12px clamp(20px, 4vw, 40px);
    margin: clamp(28px, 4vw, 44px) 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .facts dt { font-weight: 700; font-size: 1.3rem; color: var(--blue-ink); }
  .facts dd { margin: 0; font-size: 0.85rem; color: var(--text-muted); max-width: 12em; line-height: 1.4; }

  .collage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 2vw, 20px);
  }
  .collage__item {
    aspect-ratio: 1;
    padding: clamp(12px, 2vw, 20px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow);
  }
  .collage__item:nth-child(even) { transform: translateY(clamp(12px, 3vw, 28px)); }
  .collage__item { position: relative; }
  .collage__item :global(picture) { position: absolute; inset: clamp(12px, 2vw, 20px); }
  .collage__item :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .trust {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-hover);
    color: var(--blue-ink);
  }

  .band-wrap { padding-block: clamp(24px, 4vw, 40px) 0; }
  .band {
    padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 64px);
    border-radius: var(--radius);
    background: linear-gradient(15deg, var(--green), 60%, var(--blue));
    color: #fff;
  }
  .band h2 { text-shadow: 0 1px 2px rgba(0, 0, 0, 0.18); }
  .band p { max-width: 560px; margin: 0 auto 2rem; font-weight: 500; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.18); }
  .tokens {
    display: flex;
    justify-content: center;
    gap: clamp(12px, 4vw, 40px);
    list-style: none;
    margin: 0 0 clamp(28px, 5vw, 48px);
    padding: 0;
  }
  .token {
    display: grid;
    place-items: center;
    width: clamp(60px, 10vw, 80px);
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--blue-ink);
    box-shadow: var(--shadow);
  }
  .token:nth-child(even) { color: var(--green-ink); }

  /* Staggered slide-in as the band scrolls into view — pure CSS, no JS (progressive enhancement). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .token {
        animation: token-in linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 30%;
      }
      .token:nth-child(2) { animation-range: entry 20% cover 35%; }
      .token:nth-child(3) { animation-range: entry 30% cover 40%; }
      .token:nth-child(4) { animation-range: entry 40% cover 45%; }
    }
  }
  @keyframes token-in {
    from { opacity: 0; transform: translateX(-60%); }
    to { opacity: 1; transform: none; }
  }

  .value { position: relative; }
  .value__icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 18px;
    border-radius: var(--radius-sm);
    background: var(--grad-ink);
    color: #fff;
  }
  .value h3 { font-style: italic; }
  .value p { margin: 0; color: var(--text-muted); font-size: 0.95rem; }

  .featured { padding-top: 0; }
  .featured__more { margin-top: clamp(32px, 5vw, 48px); }

  @media (max-width: 560px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .hero .btn-row .btn { flex: 1 1 100%; }
  }
</style>
