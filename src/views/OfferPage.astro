---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { products } from '../config/site';
import { routes, t, type Lang } from '../i18n/ui';
import { absoluteUrl, url } from '../utils/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i18n = t(lang);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: i18n.nav.home, item: absoluteUrl(routes.home[lang], Astro.site) },
    { '@type': 'ListItem', position: 2, name: i18n.nav.offer, item: absoluteUrl(routes.offer[lang], Astro.site) },
  ],
};
---

<BaseLayout
  lang={lang}
  page="offer"
  title={i18n.offer.metaTitle}
  description={i18n.offer.metaDescription}
  schema={[breadcrumbs]}
>
  <section class="section offer">
    <div class="container">
      <header class="card offer__header">
        <div>
          <h1 class="title-grad">{i18n.offer.title}</h1>
          <p class="muted">{i18n.offer.text}</p>
        </div>
        <a href={url(routes.home[lang])} class="btn btn--ghost">{i18n.back}</a>
      </header>

      <div class="grid grid--3 offer__grid">
        {products.map((product, i) => <ProductCard product={product} lang={lang} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .offer { padding-top: clamp(8px, 2vw, 24px); }
  .offer__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(32px, 5vw, 56px) clamp(20px, 4vw, 40px);
    background:
      linear-gradient(-45deg, color-mix(in srgb, var(--blue) 18%, var(--surface)), var(--surface) 40%);
  }
  .offer__header p { max-width: 40em; margin: 0; }
  .offer__grid { margin-top: clamp(32px, 5vw, 56px); }
</style>
