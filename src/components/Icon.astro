---
// Inline SVG icon from src/assets/icons (Font Awesome Free, CC BY 4.0). Inherits currentColor.
const icons = import.meta.glob<string>('../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 32, class: className } = Astro.props;
const raw = icons[`../assets/icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace('<svg', `<svg width="${size}" height="${size}" fill="currentColor" aria-hidden="true" focusable="false"`);
---

<span class:list={['icon', className]} set:html={svg} />

<style>
  .icon { display: inline-flex; line-height: 0; }
</style>
