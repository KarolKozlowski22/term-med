---
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { routes, t, type Lang, type PageKey } from '../i18n/ui';
import { url } from '../utils/url';

interface Props {
  lang: Lang;
  page?: PageKey;
}
const { lang, page } = Astro.props;
const i18n = t(lang);

const links = [
  { label: i18n.nav.about, href: `${routes.home[lang]}#${i18n.aboutId}`, key: undefined },
  { label: i18n.nav.offer, href: routes.offer[lang], key: 'offer' },
] as const;
---

<header class="header">
  <div class="container">
    <div class="header__bar">
      <a href={url(routes.home[lang])} class="logo" aria-label={`Term-Med — ${i18n.nav.home}`}>
        <img src={url('/logo.svg')} alt="Term-Med" width="166" height="64" />
      </a>

      <div class="header__actions">
        <ThemeToggle lang={lang} />
        <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav">
          <span class="sr-only">{i18n.menu}</span>
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
          <span class="nav-toggle__bar"></span>
        </button>
      </div>

      <nav id="main-nav" class="nav" aria-label={i18n.menu}>
        <ul>
          {links.map((link) => (
            <li>
              <a href={url(link.href)} aria-current={link.key && link.key === page ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <a
          href={url(routes.contact[lang])}
          class="btn nav__cta"
          aria-current={page === 'contact' ? 'page' : undefined}
        >
          {i18n.nav.contact}
        </a>
        <LangSwitch lang={lang} page={page} />
        <p class="nav__title" aria-hidden="true">Term-Med</p>
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 12px;
  }
  .header__bar {
    position: relative;
    height: calc(var(--header-h) - 24px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-inline: clamp(16px, 3vw, 28px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--blue) 18%, transparent), transparent 30%),
      var(--bg);
    /* No backdrop-filter: a blurred sticky layer over the image grid caused first-paint
       compositing glitches in Chrome and heavy GPU load on phones. */
    box-shadow: var(--shadow);
  }
  .logo img { height: 44px; width: auto; }
  .header__actions { display: flex; align-items: center; gap: 8px; order: 2; }

  .nav { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 32px); margin-left: auto; }
  .nav ul { display: flex; gap: clamp(16px, 2.5vw, 32px); list-style: none; margin: 0; padding: 0; }
  .nav ul a {
    text-decoration: none;
    font-weight: 500;
    padding-block: 8px;
    transition: color 0.2s;
  }
  .nav ul a:hover,
  .nav ul a[aria-current='page'] { color: var(--blue-ink); }
  .nav__cta { min-height: 44px; padding: 0.6em 1.5em; }
  .nav__title { display: none; }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .nav-toggle__bar {
    display: block;
    height: 2px;
    margin: 5px 0;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .nav-toggle__bar:nth-child(3) { width: 80%; }

  @media (max-width: 860px) {
    .logo img { height: 38px; }
    .nav-toggle { display: block; }
    .nav {
      position: absolute;
      inset: calc(100% + 8px) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      padding: 24px;
      border-radius: var(--radius);
      border: 1px solid var(--line);
      background: var(--bg);
      box-shadow: var(--shadow-hover);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    }
    .nav ul { flex-direction: column; gap: 4px; }
    .nav ul a { display: block; padding: 10px 0; font-size: 1.25rem; font-style: italic; }
    .nav__cta { width: 100%; }
    .nav__title {
      display: block;
      position: relative;
      margin: 8px 0 0;
      padding: 8px;
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      background: var(--text);
      color: var(--bg);
      font-weight: 700;
      font-style: italic;
      text-align: center;
    }
    .nav__title::after {
      content: '';
      position: absolute;
      inset: 100% 0 auto 0;
      height: 6px;
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      background: var(--grad);
    }
    :global(body.nav-open) .nav { opacity: 1; visibility: visible; transform: none; }
    :global(body.nav-open) .nav-toggle__bar:nth-child(2) { transform: translateY(7px) rotate(45deg); }
    :global(body.nav-open) .nav-toggle__bar:nth-child(3) { opacity: 0; transform: translateX(-100%); }
    :global(body.nav-open) .nav-toggle__bar:nth-child(4) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const setOpen = (open: boolean) => {
    document.body.classList.toggle('nav-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(!document.body.classList.contains('nav-open')));
  document.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 861px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
