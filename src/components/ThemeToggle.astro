---
// Light/dark switch. Defaults to the OS preference; an explicit choice is saved in localStorage
// and applied before first paint by the inline script in BaseLayout.
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<button type="button" class="theme-toggle" aria-label={t(lang).themeToggle} title={t(lang).themeToggle}>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
  </svg>
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .theme-toggle:hover { color: var(--blue-ink); border-color: var(--blue); }
  .theme-toggle svg {
    grid-area: 1 / 1;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .theme-toggle__sun { opacity: 0; transform: rotate(-90deg) scale(0.6); }

  /* Show the sun while dark (click → light), the moon while light. */
  :global(:root[data-theme='dark']) .theme-toggle__sun { opacity: 1; transform: none; }
  :global(:root[data-theme='dark']) .theme-toggle__moon { opacity: 0; transform: rotate(90deg) scale(0.6); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__sun { opacity: 1; transform: none; }
    :global(:root:not([data-theme='light'])) .theme-toggle__moon { opacity: 0; transform: rotate(90deg) scale(0.6); }
  }
</style>

<script>
  type Theme = 'light' | 'dark';
  declare global {
    interface Window {
      applyTheme?: (theme?: Theme | null) => void; // defined by the inline bootstrap in BaseLayout
    }
  }

  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');
  const current = (): Theme => (root.dataset.theme as Theme | undefined) ?? (media.matches ? 'dark' : 'light');

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const next: Theme = current() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage blocked (private mode) — the choice still applies to this page.
      }
      window.applyTheme?.(next);
    });
  });
</script>
