---
import ContactIcon from './ContactIcon.astro';
import { site } from '../config/site';
import { routes, t, type Lang } from '../i18n/ui';
import { url } from '../utils/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const i18n = t(lang);
const { contact } = site;
const year = new Date().getFullYear();
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.mapQuery)}`;
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href={url(routes.home[lang])} aria-label={`Term-Med — ${i18n.nav.home}`}>
        <img src={url('/logo.svg')} alt="Term-Med" width="166" height="64" loading="lazy" decoding="async" />
      </a>
      <a href={mapsLink} class="footer__contact footer__address" target="_blank" rel="noopener">
        <ContactIcon name="pin" size="sm" />
        <address>
          {contact.street}<br />
          {contact.postalCode} {contact.city}, {i18n.contactPage.country}
        </address>
      </a>
    </div>

    <div>
      <p class="footer__label">{i18n.footer.contact}</p>
      <ul class="footer__contacts">
        <li>
          <a href={`tel:${contact.phoneHref}`} class="footer__contact">
            <ContactIcon name="phone" size="sm" />
            <span>{contact.phone}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.salesEmail}`} class="footer__contact">
            <ContactIcon name="mail" size="sm" />
            <span><small>{i18n.contactPage.sales}</small>{contact.salesEmail}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.infoEmail}`} class="footer__contact">
            <ContactIcon name="mail" size="sm" />
            <span><small>{i18n.contactPage.info}</small>{contact.infoEmail}</span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="footer__label">{i18n.footer.links}</p>
      <ul>
        <li><a href={url(`${routes.home[lang]}#${i18n.aboutId}`)}>{i18n.nav.about}</a></li>
        <li><a href={url(routes.offer[lang])}>{i18n.nav.offer}</a></li>
        <li><a href={url(routes.contact[lang])}>{i18n.nav.contact}</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {site.founded}–{year} {site.brand}. {i18n.footer.rights}</span>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(32px, 5vw, 64px);
    padding-top: clamp(48px, 7vw, 80px);
    background: var(--footer-bg);
    color: #f1f1f1;
    position: relative;
  }
  .footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 6px;
    background: var(--grad);
  }
  .footer a { text-decoration: none; transition: color 0.2s; }
  .footer a:hover { color: var(--blue); }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .footer ul a { display: inline-block; padding-block: 4px; }
  .footer address { font-style: normal; color: #c9c9c9; line-height: 1.5; }
  .footer__address { margin-top: 20px; }
  .footer__contacts { gap: 14px; }
  .footer__contact { display: inline-flex; align-items: center; gap: 14px; line-height: 1.35; }
  .footer__contact small {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9aa3ab;
  }
  .footer ul a.footer__contact { display: inline-flex; padding-block: 2px; }
  .footer__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; }
  .footer__brand img { height: 52px; width: auto; }
  .footer__label {
    font-style: italic;
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .footer__bottom {
    margin-top: 48px;
    padding-block: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.85rem;
    color: #b5b5b5;
  }
  @media (max-width: 860px) {
    .footer { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }
  }
</style>
