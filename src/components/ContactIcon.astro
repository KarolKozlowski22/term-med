---
/**
 * Contact icon in a brand-gradient tile: phone, mail or pin.
 * Animates when its parent link is hovered/focused (phone rings, envelope flap opens, pin bounces).
 */
interface Props {
  name: 'phone' | 'mail' | 'pin';
  size?: 'sm' | 'md';
}
const { name, size = 'md' } = Astro.props;

const paths = {
  phone:
    '<path class="ci__waves" d="M14.5 3.5a6 6 0 0 1 6 6M14.5 7a2.5 2.5 0 0 1 2.5 2.5"/>' +
    '<path d="M5.2 3.5h3l1.6 4.1-2 1.3a11 11 0 0 0 7.3 7.3l1.3-2 4.1 1.6v3a1.8 1.8 0 0 1-1.9 1.8A16.6 16.6 0 0 1 3.4 5.4a1.8 1.8 0 0 1 1.8-1.9z"/>',
  mail:
    '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/>' +
    '<path class="ci__flap" d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  pin: '<path d="M12 21.5s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="9.5" r="2.5"/>',
};
---

<span class:list={['ci', `ci--${name}`, `ci--${size}`]} aria-hidden="true">
  <svg viewBox="0 0 24 24" set:html={paths[name]} />
</span>

<style>
  .ci {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--btn-grad);
    color: #fff;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--blue) 35%, transparent);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  /* soft glossy highlight */
  .ci::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.28), transparent 55%);
    pointer-events: none;
  }
  .ci--md { width: 44px; height: 44px; }
  .ci--sm { width: 36px; height: 36px; border-radius: 10px; }
  .ci svg {
    width: 55%;
    height: 55%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .ci :global(.ci__waves) { opacity: 0.55; transition: opacity 0.2s; }
  .ci :global(.ci__flap) { transform-origin: 12px 6px; transition: transform 0.3s ease; }

  :global(a:is(:hover, :focus-visible)) > .ci {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--blue) 45%, transparent);
  }
  :global(a:is(:hover, :focus-visible)) > .ci--phone svg { animation: ring 0.8s ease-in-out; }
  :global(a:is(:hover, :focus-visible)) > .ci--phone :global(.ci__waves) { opacity: 1; animation: waves 0.8s ease-in-out infinite alternate; }
  :global(a:is(:hover, :focus-visible)) > .ci--mail :global(.ci__flap) { transform: scaleY(-1) translateY(-1px); }
  :global(a:is(:hover, :focus-visible)) > .ci--pin svg { animation: bounce 0.7s ease; }

  @keyframes ring {
    0%, 100% { transform: rotate(0); }
    15%, 45%, 75% { transform: rotate(-14deg); }
    30%, 60%, 90% { transform: rotate(14deg); }
  }
  @keyframes waves {
    from { opacity: 0.35; }
    to { opacity: 1; }
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    40% { transform: translateY(-4px); }
    70% { transform: translateY(1px); }
  }
</style>
